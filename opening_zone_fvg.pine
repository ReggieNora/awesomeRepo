//@version=5
indicator("Opening Zone + FVG", overlay=true, max_boxes_count=500, max_lines_count=500)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
var zoneColor  = input.color(color.new(color.yellow, 80), "Zone Color")
var zoneBorder = input.color(color.new(color.yellow, 20), "Zone Border Color")
var bullColor  = input.color(color.new(color.green,  75), "Bullish FVG Color")
var bearColor  = input.color(color.new(color.red,    75), "Bearish FVG Color")
var showFVG    = input.bool(true, "Show FVGs on Breach")

// ─── OPENING CANDLE ───────────────────────────────────────────────────────────
// Pine Script 'hour'/'minute' use the exchange timezone (America/New_York for
// NYSE/NASDAQ), so 9:30 EST maps directly to hour==9, minute==30.
// We pull from the 1m chart so the zone is always the exact 9:30 1-min candle,
// regardless of what timeframe the chart is set to.
[oz_high, oz_low] = request.security("", "1",
     [ta.valuewhen(hour == 9 and minute == 30, high, 0),
      ta.valuewhen(hour == 9 and minute == 30, low,  0)],
     lookahead = barmerge.lookahead_off)

// ─── STATE ────────────────────────────────────────────────────────────────────
var box   zoneBox      = na
var float savedHigh    = na
var float savedLow     = na
var bool  highBreached = false
var bool  lowBreached  = false

// Detect when we've just crossed into a new trading day
bool newDay = ta.change(time("D")) != 0

if newDay
    highBreached := false
    lowBreached  := false
    savedHigh    := oz_high
    savedLow     := oz_low
    if not na(zoneBox)
        box.delete(zoneBox)
    zoneBox := box.new(bar_index, savedHigh, bar_index + 1, savedLow,
         border_color = zoneBorder, border_width = 1, bgcolor = zoneColor)

// Extend zone box to current bar on every tick
if not na(zoneBox)
    box.set_right(zoneBox, bar_index + 1)

// ─── BREACH DETECTION (5-min close) ───────────────────────────────────────────
fiveClose = request.security("", "5", close, lookahead = barmerge.lookahead_off)

bool bullBreach = not highBreached and not na(savedHigh) and fiveClose > savedHigh
bool bearBreach = not lowBreached  and not na(savedLow)  and fiveClose < savedLow

// ─── FVG DETECTION (1-min bars) ───────────────────────────────────────────────
// Bullish FVG : low[0] > high[2]  — gap between current low and the high 2 bars back
// Bearish FVG : high[0] < low[2]  — gap between current high and the low 2 bars back
[h0, l0, h2, l2] = request.security("", "1",
     [high, low, high[2], low[2]],
     lookahead = barmerge.lookahead_off)

bool isBullFVG = l0 > h2
bool isBearFVG = h0 < l2

// ─── DRAW FVG ON BREACH ───────────────────────────────────────────────────────
if bullBreach
    highBreached := true
    if showFVG and isBullFVG
        box.new(bar_index - 2, l0, bar_index + 20, h2,
             border_color = color.new(color.green, 20), border_width = 1, bgcolor = bullColor)
        label.new(bar_index, l0, "Bull FVG\n(OZ breach ↑)",
             style = label.style_label_down,
             color = color.new(color.green, 20), textcolor = color.white, size = size.small)

if bearBreach
    lowBreached := true
    if showFVG and isBearFVG
        box.new(bar_index - 2, l2, bar_index + 20, h0,
             border_color = color.new(color.red, 20), border_width = 1, bgcolor = bearColor)
        label.new(bar_index, h0, "Bear FVG\n(OZ breach ↓)",
             style = label.style_label_up,
             color = color.new(color.red, 20), textcolor = color.white, size = size.small)

// ─── PLOTS / ALERTS ───────────────────────────────────────────────────────────
plot(savedHigh, "OZ High", color = zoneBorder, linewidth = 1, style = plot.style_stepline)
plot(savedLow,  "OZ Low",  color = zoneBorder, linewidth = 1, style = plot.style_stepline)

alertcondition(bullBreach and isBullFVG, "Bull OZ Breach + FVG", "Price broke above Opening Zone — Bullish FVG on 1m")
alertcondition(bearBreach and isBearFVG, "Bear OZ Breach + FVG", "Price broke below Opening Zone — Bearish FVG on 1m")
