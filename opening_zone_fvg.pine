//@version=5
indicator("Opening Zone + FVG", overlay=true, max_boxes_count=500, max_lines_count=500)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
zoneColor  = input.color(color.new(color.yellow, 80), "Zone Color")
zoneBorder = input.color(color.new(color.yellow, 20), "Zone Border Color")
bullColor  = input.color(color.new(color.green,  75), "Bullish FVG Color")
bearColor  = input.color(color.new(color.red,    75), "Bearish FVG Color")
showFVG    = input.bool(true, "Show FVGs on Breach")

// ─── NEW YORK TIME ────────────────────────────────────────────────────────────
nyHour   = hour(time,   "America/New_York")
nyMinute = minute(time, "America/New_York")

is930  = nyHour == 9  and nyMinute == 30
is1600 = nyHour == 16 and nyMinute == 0

// ─── STATE ────────────────────────────────────────────────────────────────────
var float ozHigh    = na
var float ozLow     = na
var box   zoneBox   = na
var bool  active    = false
var bool  bullDone  = false
var bool  bearDone  = false

// ─── 9:30 — DRAW ZONE ────────────────────────────────────────────────────────
// Fires once per day on the exact 9:30 bar. Deletes the prior day's box and
// draws a new one using this candle's high/low.
if is930
    ozHigh   := high
    ozLow    := low
    bullDone := false
    bearDone := false
    active   := true
    if not na(zoneBox)
        box.delete(zoneBox)
    zoneBox := box.new(bar_index, high, bar_index + 1, low,
         border_color = zoneBorder, border_width = 1, bgcolor = zoneColor)

// ─── EXTEND ZONE EACH BAR UNTIL 4 PM ─────────────────────────────────────────
if active and not na(zoneBox)
    box.set_right(zoneBox, bar_index + 1)

if is1600
    active := false

// ─── 5-MIN BREACH DETECTION ───────────────────────────────────────────────────
// Pull the 5-min close. On a 1m chart this gives us the most recent 5m candle's
// closing price — breach only counts when a full 5m candle closes outside zone.
fiveClose = request.security("", "5", close, lookahead = barmerge.lookahead_off)

bullBreach = active and not bullDone and not na(ozHigh) and fiveClose > ozHigh
bearBreach = active and not bearDone and not na(ozLow)  and fiveClose < ozLow

// ─── FVG DETECTION (current chart bars — run on 1m chart) ────────────────────
// Bullish FVG: gap exists when current low is above the high from 2 bars ago
// Bearish FVG: gap exists when current high is below the low from 2 bars ago
isBullFVG = low  > high[2]
isBearFVG = high < low[2]

// ─── DRAW FVG ON BREACH ───────────────────────────────────────────────────────
if bullBreach
    bullDone := true
    if showFVG and isBullFVG
        box.new(bar_index - 2, low, bar_index + 20, high[2],
             border_color = color.new(color.green, 20), border_width = 1, bgcolor = bullColor)
        label.new(bar_index, low, "Bull FVG\n(OZ breach ↑)",
             style     = label.style_label_down,
             color     = color.new(color.green, 20),
             textcolor = color.white,
             size      = size.small)

if bearBreach
    bearDone := true
    if showFVG and isBearFVG
        box.new(bar_index - 2, low[2], bar_index + 20, high,
             border_color = color.new(color.red, 20), border_width = 1, bgcolor = bearColor)
        label.new(bar_index, high, "Bear FVG\n(OZ breach ↓)",
             style     = label.style_label_up,
             color     = color.new(color.red, 20),
             textcolor = color.white,
             size      = size.small)

// ─── PLOTS ────────────────────────────────────────────────────────────────────
plot(ozHigh, "OZ High", color = zoneBorder, linewidth = 1, style = plot.style_stepline)
plot(ozLow,  "OZ Low",  color = zoneBorder, linewidth = 1, style = plot.style_stepline)

// ─── ALERTS ───────────────────────────────────────────────────────────────────
alertcondition(bullBreach and isBullFVG, "Bull OZ Breach + FVG", "Price broke above Opening Zone — Bullish FVG present")
alertcondition(bearBreach and isBearFVG, "Bear OZ Breach + FVG", "Price broke below Opening Zone — Bearish FVG present")
